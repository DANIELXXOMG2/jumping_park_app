rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        (request.auth.token.role == 'admin' || request.auth.token.admin == true);
    }

    // Las firmas reales viven en rutas anidadas `signatures/{documentId}/...`.
    // La carga/lectura productiva se hace via Admin SDK + signed URLs, no desde el cliente.
    match /signatures/{userId}/{assetPath=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Los PDFs de consentimiento se generan on-demand via API y no deben persistirse
    // desde clientes. Este namespace queda explícitamente reservado/bloqueado.
    match /generated-pdfs/{documentPath=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
