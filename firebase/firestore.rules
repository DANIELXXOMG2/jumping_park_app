rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // FUNCIONES HELPER - RBAC con Custom Claims
    // =========================================================================
    
    // Verifica si el usuario tiene rol admin (via custom claim)
    function isAdmin() {
      return request.auth != null && 
             (request.auth.token.role == 'admin' || request.auth.token.admin == true);
    }
    
    // Verifica si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // =========================================================================
    // COLECCIÓN: admin_users (RBAC - Solo lectura para referencia)
    // =========================================================================
    match /admin_users/{userId} {
      // Solo admins pueden leer usuarios admin (trabajadores NO)
      allow read: if isAdmin();
      // Solo escritura via Admin SDK (server-side)
      allow write: if false;
    }
    
    // =========================================================================
    // COLECCIÓN: users
    // =========================================================================
    match /users/{userId} {
      // Usuarios pueden leer/escribir su propio documento
      // Admins pueden leer cualquier usuario (para panel admin)
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // =========================================================================
    // COLECCIONES OTP (Solo acceso server-side via Admin SDK)
    // =========================================================================
    match /otp_challenges/{documentId} {
      allow read, write: if false;
    }

    match /otp_access_sessions/{documentId} {
      allow read, write: if false;
    }

    match /otp_sessions/{documentId} {
      allow read, write: if false;
    }

    // =========================================================================
    // COLECCIÓN: offline_sync (ledger server-side de replay offline)
    // =========================================================================
    match /offline_sync/{documentId} {
      allow read, write: if false;
    }

    // =========================================================================
    // COLECCIÓN: minors_index (proyección denormalizada solo server-side)
    // =========================================================================
    match /minors_index/{documentId} {
      allow read, write: if false;
    }

    // =========================================================================
    // COLECCIÓN: admin_metrics (read model server-side)
    // =========================================================================
    match /admin_metrics/{documentId} {
      allow read, write: if false;
    }

    // =========================================================================
    // COLECCIÓN: admin_audit_logs (traza inmutable solo server-side)
    // =========================================================================
    match /admin_audit_logs/{documentId} {
      allow read, write: if false;
    }

    // =========================================================================
    // COLECCIÓN: consents
    // =========================================================================
    match /consents/{consentId} {
      // Usuario puede leer sus propios consentimientos
      // Solo admins pueden leer cualquier consentimiento (trabajadores NO)
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      // Solo escritura via Admin SDK (server-side)
      allow write: if false;
    }
    
    // =========================================================================
    // COLECCIÓN: accesses (registros de ingreso)
    // =========================================================================
    match /accesses/{accessId} {
      // Solo admins pueden leer/escribir (trabajadores NO)
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // COLECCIÓN: _counters (internal atomic counters — Admin SDK only)
    // =========================================================================
    match /_counters/{documentId} {
      allow read, write: if false;
    }

    // =========================================================================
    // COLECCIÓN: settings (consent content configuration — Admin SDK / server only)
    // =========================================================================
    match /settings/{documentId} {
      allow read, write: if false;
    }

    // =========================================================================
    // COLECCIÓN: rate_limits (OTP/security rate limiting — Admin SDK only)
    // =========================================================================
    match /rate_limits/{documentId} {
      allow read, write: if false;
    }

    // =========================================================================
    // DEFAULT: Denegar todo lo demás
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
