{
  "name": "jumping_park_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "playwright:install": "playwright install chromium",
    "test": "bun test",
    "test:a11y:e2e": "playwright test --config=playwright.config.ts",
    "check": "bun run check:format && bun run check:lint && bun run check:types && bun run audit",
    "check:format": "biome check src/ --formatter-enabled=true --linter-enabled=false --assist-enabled=false",
    "check:lint": "biome lint src/",
    "check:types": "tsc --noEmit",
    "check:phase5": "bun test tests/seo-public.test.ts tests/offline-resilience.test.ts tests/phase5-verification-hardening.test.ts tests/block-e-offline-replay.test.ts tests/block-e-runtime-proof.test.ts tests/block-e-a11y-smoke.test.tsx && bun run test:a11y:e2e",
    "fix:format": "biome check src/ --write --formatter-enabled=true --linter-enabled=false --assist-enabled=false",
    "fix:lint": "biome lint src/ --write",
    "audit": "bun run audit:dead && bun run audit:dupe && bun run audit:circ",
    "audit:dead": "knip",
    "audit:dupe": "jscpd src/ --config .jscpd.json",
    "audit:circ": "depcruise src --include-only \"^src\" --config .dependency-cruiser.js",
    "seed": "bun run scripts/seed-database.ts",
    "set-admin": "bun run scripts/set-admin-role.ts",
    "migrate:minors": "bun run scripts/migrate-minors.ts",
    "migrate:search-tokens": "bun run scripts/migrate-search-tokens.ts",
    "migrate:consent-minor-tokens": "bun run scripts/migrate-consent-minor-tokens.ts",
    "migrate:minor-search-tokens": "bun run scripts/migrate-minor-search-tokens.ts",
    "migrate:tildes": "bun run scripts/migrate-search-tokens-tildes.ts",
    "backup": "bun run scripts/backup.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "boring-avatars": "^2.0.4",
    "clsx": "^2.1.1",
    "firebase": "12.11.0",
    "firebase-admin": "13.7.0",
    "framer-motion": "^12.23.25",
    "lucide-react": "^0.561.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.68.0",
    "react-signature-canvas": "1.1.0-alpha.2",
    "resend": "^6.5.2",
    "snd-lib": "^1.2.4",
    "sonner": "^2.0.7",
    "swr": "^2.3.8",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@biomejs/biome": "2.4.10",
    "@faker-js/faker": "^10.1.0",
    "@next/bundle-analyzer": "16.2.6",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "axe-core": "^4.11.2",
    "dependency-cruiser": "17.3.10",
    "dotenv": "17.4.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jscpd": "4.0.8",
    "knip": "5.88.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "protobufjs": "7.5.6"
  }
}
