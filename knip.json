{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "next.config.ts",
    "src/app/**/{page,layout,loading,error,not-found,route,template,default}.{ts,tsx}",
    "scripts/**/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{ts,tsx}"],
  "ignore": [
    "**/*.d.ts",
    "src/components/ui/**"
  ],
  "ignoreBinaries": [], 
  "ignoreDependencies": [],
  
  "includeEntryExports": true,
  "ignoreExportsUsedInFile": true,
  
  "include": [
    "classMembers",
    "enumMembers",
    "exports",
    "types",
    "unresolved",
    "duplicates"
  ],
  
  "rules": {
    "exports": "warn",
    "types": "warn"
  }
}