{
  "threshold": 0,
  "minTokens": 40,
  "minLines": 5,
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/*.d.ts",
    "src/components/ui/**",
    "src/lib/utils/index.ts"
  ],
  "format": ["typescript", "javascript", "tsx"],
  "mode": "weak",
  "ignorePattern": [
    "import .*",
    "export .* from .*"
  ],
  "reporters": ["console", "html"]
}